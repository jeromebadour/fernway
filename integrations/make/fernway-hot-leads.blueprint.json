    {
      "id": 10,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {
        "type": ""
      },
      "filter": {
        "name": "Signed by Fernway, sent in the last 5 minutes",
        "conditions": [
          [
            {
              "a": "{{8.want}}",
              "b": "{{6.v1}}",
              "o": "text:equal"
            },
            {
              "a": "{{9.age}}",
              "b": "300",
              "o": "number:lessorequal"
            },
            {
              "a": "{{9.age}}",
              "b": "-300",
              "o": "number:greaterorequal"
            }
          ]
        ]
      },
      "mapper": {
        "json": "{{1.value}}"
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 0
        },
        "restore": {},
        "parameters": [
          {
            "name": "type",
            "type": "udt",
            "label": "Data structure"
          }
        ],
        "expect": [
          {
            "name": "json",
            "type": "text",
            "label": "JSON string",
            "required": true
          }
        ]
      }
    },
    {
      "id": 11,
      "module": "google-sheets:addRow",
      "version": 2,
      "parameters": {},
      "filter": {
        "name": "Scored 4 or 5",
        "conditions": [
          [
            {
              "a": "{{10.type}}",
              "b": "lead.scored",
              "o": "text:equal"
            },
            {
              "a": "{{10.data.score.score}}",
              "b": "4",
              "o": "number:greaterorequal"
            }
          ]
        ]
      },
      "mapper": {
        "mode": "map",
        "from": "drive",
        "spreadsheetId": "PASTE_SPREADSHEET_ID_HERE",
        "sheetId": "Make hot leads",
        "includesHeaders": true,
        "insertDataOption": "INSERT_ROWS",
        "valueInputOption": "RAW",
        "insertUnformatted": false,
        "values": {
          "0": "{{10.data.waybill}}",
          "1": "{{formatDate(10.created; \"YYYY-MM-DD HH:mm:ss\"; \"UTC\")}}",
          "2": "{{10.data.score.score}}",
          "3": "{{10.data.contact.firstName}} {{10.data.contact.lastName}}",
          "4": "{{10.data.contact.email}}",
          "5": "{{10.data.contact.phone}}",
          "6": "{{10.data.contact.companyName}}",
          "7": "{{10.data.score.summary}}",
          "8": "{{10.data.receipt}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 0
        },
        "restore": {}
      }
