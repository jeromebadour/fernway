        }
      }
    },
    {
      "id": "6f1d1b8e-1a1e-4c6e-9a2e-0c7f3f1a0006",
      "name": "Scored 4 or 5?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
