          "rawBody": true
        }
      }
    },
    {
      "id": "6f1d1b8e-1a1e-4c6e-9a2e-0c7f3f1a0002",
      "name": "Check Fernway's signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Fernway signs every call: Fernway-Signature: t=<unix>,v1=<hex HMAC-SHA256(secret, \"<t>.<raw body>\")>.\n// The check runs on the raw bytes, compares in constant time, and refuses a time more than 5 minutes off.\nconst crypto = require('crypto');\nconst secret = $env.FERNWAY_HOOK_SECRET;\nconst header = String($json.headers['fernway-signature'] ?? '');\nconst parts = Object.fromEntries(header.split(',').map((p) => p.split('=')));\nconst raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst want = crypto.createHmac('sha256', secret ?? '').update(`${parts.t}.${raw}`).digest('hex');\nconst fresh = Math.abs(Date.now() / 1000 - Number(parts.t)) <= 300;\nconst same = typeof parts.v1 === 'string' && parts.v1.length === want.length && crypto.timingSafeEqual(Buffer.from(parts.v1), Buffer.from(want));\nconst signed = Boolean(secret) && fresh && same;\nreturn { json: { signed, event: signed ? JSON.parse(raw) : null } };"
      }
    },
    {
      "id": "6f1d1b8e-1a1e-4c6e-9a2e-0c7f3f1a0003",
      "name": "Signed by Fernway?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.signed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6f1d1b8e-1a1e-4c6e-9a2e-0c7f3f1a0004",
      "name": "Answer 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { received: true, id: $json.event.id } }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "6f1d1b8e-1a1e-4c6e-9a2e-0c7f3f1a0005",
      "name": "Answer 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
